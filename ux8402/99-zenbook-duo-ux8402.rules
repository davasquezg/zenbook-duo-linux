# Zenbook Duo UX8402ZA - acceso sin privilegios al hardware propio del modelo.
#
# Evita las entradas NOPASSWD en /etc/sudoers que instala el setup.sh original
# (que además apuntaban a un script en /tmp, ruta escribible por el usuario).
# El usuario debe pertenecer al grupo 'video'.

# Backlight del ScreenPad Plus: nivel y encendido/apagado
ACTION=="add", SUBSYSTEM=="backlight", KERNEL=="asus_screenpad", \
  RUN+="/bin/chgrp video /sys/class/backlight/%k/brightness /sys/class/backlight/%k/bl_power", \
  RUN+="/bin/chmod g+w /sys/class/backlight/%k/brightness /sys/class/backlight/%k/bl_power"

# Backlight del teclado integrado
ACTION=="add", SUBSYSTEM=="leds", KERNEL=="asus::kbd_backlight", \
  RUN+="/bin/chgrp video /sys/class/leds/%k/brightness", \
  RUN+="/bin/chmod g+w /sys/class/leds/%k/brightness"
